// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`OMAP builder — golden snapshots per symbol category > along-line mid symbol (fence ticks) 1`] = `
"<svg xmlns="http://www.w3.org/2000/svg" viewBox="-200 -200 4400 400">
<rect x="-200" y="-200" width="4400" height="400" fill="white"/>
<path d="M0 0 L4000 0" fill="none" stroke="rgb(0,0,0)" stroke-width="80" stroke-linecap="round" stroke-linejoin="round" data-ink="upper"/>
<g transform="translate(0,0) rotate(0)"><path d="M0 -200 L0 200" fill="none" stroke="rgb(0,0,0)" stroke-width="60" stroke-linecap="round" stroke-linejoin="round"/></g>
<g transform="translate(1000,0) rotate(0)"><path d="M0 -200 L0 200" fill="none" stroke="rgb(0,0,0)" stroke-width="60" stroke-linecap="round" stroke-linejoin="round"/></g>
<g transform="translate(2000,0) rotate(0)"><path d="M0 -200 L0 200" fill="none" stroke="rgb(0,0,0)" stroke-width="60" stroke-linecap="round" stroke-linejoin="round"/></g>
<g transform="translate(3000,0) rotate(0)"><path d="M0 -200 L0 200" fill="none" stroke="rgb(0,0,0)" stroke-width="60" stroke-linecap="round" stroke-linejoin="round"/></g>
<g transform="translate(4000,0) rotate(0)"><path d="M0 -200 L0 200" fill="none" stroke="rgb(0,0,0)" stroke-width="60" stroke-linecap="round" stroke-linejoin="round"/></g>
</svg>"
`;

