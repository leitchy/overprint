exports[`OMAP builder — golden snapshots per symbol category > area with dot pattern 1`] = `
"<svg xmlns="http://www.w3.org/2000/svg" viewBox="-100 -100 2200 2200">
<defs>
<pattern id="pat-1-0" patternUnits="userSpaceOnUse" width="600" height="600" patternTransform="rotate(0, 0, 0)"><circle cx="300" cy="300" r="90" fill="rgb(0,0,0)"/></pattern>
</defs>
<rect x="-100" y="-100" width="2200" height="2200" fill="white"/>
<path d="M0 0 L2000 0 L2000 2000 L0 2000 Z" fill="url(#pat-1-0)" fill-rule="evenodd"/>
</svg>"
`;

