<symbol type="2" id="140" code="518" name="Impassable fence or railing"><description>An impassable fence or railing shall not be crossed.
If the length is shorter than 3 mm, it must be presented with the symbol Impassable wall (515).
Minimum length (isolated): 3 mm (footprint 12 m).</description><line_symbol color="3" line_width="533" minimum_length="4000" join_style="1" cap_style="0" start_offset="0" end_offset="0" segment_length="5000" end_length="3100" minimum_mid_symbol_count="0" minimum_mid_symbol_count_when_closed="0" dash_length="5333" break_length="1333" dashes_in_group="1" in_group_break_length="667" mid_symbols_per_spot="1" mid_symbol_distance="0"><mid_symbol><symbol type="1" code="" name="Mid symbol"><point_symbol rotatable="true" inner_radius="1333" inner_color="-1" outer_width="0" outer_color="-1" elements="2"><element><symbol type="2" code=""><line_symbol color="3" line_width="187" minimum_length="0" join_style="1" cap_style="0" start_offset="0" end_offset="0" segment_length="5333" end_length="0" show_at_least_one_symbol="true" minimum_mid_symbol_count="0" minimum_mid_symbol_count_when_closed="0" dash_length="5333" break_length="1333" dashes_in_group="1" in_group_break_length="667" mid_symbols_per_spot="1" mid_symbol_distance="0"/></symbol><object type="1"><coords count="2">600 0;1100 867;</coords><pattern rotation="0"><coord x="0" y="0"/></pattern></object></element><element><symbol type="2" code=""><line_symbol color="3" line_width="187" minimum_length="0" join_style="1" cap_style="0" start_offset="0" end_offset="0" segment_length="5333" end_length="0" show_at_least_one_symbol="true" minimum_mid_symbol_count="0" minimum_mid_symbol_count_when_closed="0" dash_length="5333" break_length="1333" dashes_in_group="1" in_group_break_length="667" mid_symbols_per_spot="1" mid_symbol_distance="0"/></symbol><object type="1"><coords count="2">-600 0;-100 867;</coords><pattern rotation="0"><coord x="0" y="0"/></pattern></object></element></point_symbol></symbol></mid_symbol></line_symbol></symbol>
<symbol type="1" id="141" code="519" name="Crossing point (optional)"><description>A crossing point is a gap or an opening in a fence, railing or wall, which can easily be passed through by a competitor.
Small gaps or openings which cannot easily be passed through by competitors, shall not be represented on the map and shall be closed during the competition.</description><point_symbol rotatable="true" inner_radius="1333" inner_color="-1" outer_width="0" outer_color="-1" elements="2"><element><symbol type="2" code=""><line_symbol color="3" line_width="333" minimum_length="0" join_style="1" cap_style="0" start_offset="0" end_offset="0" segment_length="5333" end_length="0" show_at_least_one_symbol="true" minimum_mid_symbol_count="0" minimum_mid_symbol_count_when_closed="0" dash_length="5333" break_length="1333" dashes_in_group="1" in_group_break_length="667" mid_symbols_per_spot="1" mid_symbol_distance="0"/></symbol><object type="1"><coords count="2">833 -933;833 933;</coords><pattern rotation="0"><coord x="0" y="0"/></pattern></object></element><element><symbol type="2" code=""><line_symbol color="3" line_width="333" minimum_length="0" join_style="1" cap_style="0" start_offset="0" end_offset="0" segment_length="5333" end_length="0" show_at_least_one_symbol="true" minimum_mid_symbol_count="0" minimum_mid_symbol_count_when_closed="0" dash_length="5333" break_length="1333" dashes_in_group="1" in_group_break_length="667" mid_symbols_per_spot="1" mid_symbol_distance="0"/></symbol><object type="1"><coords count="2">-833 -933;-833 933;</coords><pattern rotation="0"><coord x="0" y="0"/></pattern></object></element></point_symbol></symbol>
